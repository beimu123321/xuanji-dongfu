# 服务端配置（复制为 .env 后按需修改）
PORT=3000
NODE_ENV=development

# JWT 签名密钥（生产环境务必替换为随机长字符串）
JWT_SECRET=xuanji-dongfu-dev-secret-please-change
# JWT 有效期（支持 1h / 7d / 30d 等）
JWT_EXPIRES_IN=7d

# 默认管理员（仅在数据文件不存在、首次初始化时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<change-me>

# 允许跨域的来源，多个用英文逗号分隔；* 表示全部允许
CORS_ORIGIN=*
